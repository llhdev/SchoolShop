EXPO_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-anon-public-key>
EXPO_PUBLIC_ADMIN_EMAIL=admin@example.com
EXPO_PUBLIC_ADMIN_PASSWORD=<your-admin-password>

# Service role key is only used by setup scripts (never bundled into the app).
# SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Used temporarily by scripts/create-tenant.js.
# TENANT_EMAIL=tenant@example.com
# TENANT_PASSWORD=<tenant-password>
