{
  "expo": {
    "name": "Gold Fashion",
    "slug": "OnlineShop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.libeamlak.onlineshop",
      "adaptiveIcon": {
        "backgroundColor": "#f5ca59",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "a2a18c75-3bb0-4dfe-a9ca-44ef89b30464"
      }
    },
    "owner": "libeamlak"
  }
}
